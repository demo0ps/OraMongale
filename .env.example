# ORAMONGALE environment variables (local dev).
# This file is git-ignored. Never commit real secrets.
AUTH_SECRET=dev-only-secret-replace-me-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# Bootstrap admin account (created on first run if no admin exists).
ADMIN_BOOTSTRAP_EMAIL=admin@oramongale.co.za
ADMIN_BOOTSTRAP_PASSWORD=change-me-on-first-login

DATABASE_URL=file:./data/oramongale.db
